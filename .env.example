# ==============================================================================
# OfficeBazzar E-Commerce Production Environment Configuration Template
# Copy this file to .env.local and populate with your credentials.
# Never commit .env.local containing live secrets to public version control.
# ==============================================================================

# 1. Site Public URL (Used for SEO Canonical, OpenGraph & Sitemap Generation)
NEXT_PUBLIC_SITE_URL=https://www.officebazzar.com

# 2. Razorpay Payment Gateway Credentials (Optional fallback / legacy orders)
# Obtain from: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_key

# 3. Registered Corporate Tax Data
# Set only after verifying against official corporate GST registration certificate
OFFICEBAZZAR_GSTIN=

# 4. Security & Session Secrets
ADMIN_SECRET_KEY=generate-a-cryptographically-secure-random-token

# 5. B2B Quotation System & Notification Engine Configuration
# Recipient destinations for Request a Quote submissions (sent to both Sales and Marketing)
QUOTE_SALES_EMAIL=sales4@officebazzar.com
QUOTE_MARKETING_EMAIL=marketing@officebazzar.com
ADMIN_NOTIFICATION_EMAIL=admin@officebazzar.co.in
SALES_MANAGER_NOTIFICATION_EMAIL=sales@officebazzar.co.in

# Transactional Email Service (Resend / SendGrid / Postmark / SMTP)
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@officebazzar.co.in

# Optional Official Meta WhatsApp Business Platform
# Configured via Meta for Developers: https://developers.facebook.com/apps/
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_PHONE=+919043849095
WHATSAPP_SALES_PHONE=

# 6. Zoho CRM Server-Side OAuth 2.0 Integration (Authoritative Business Database)
# Obtain credentials from Zoho API Console: https://api-console.zoho.in (India) or https://api-console.zoho.com (US/Global)
# Create a 'Server-based Applications' client with scopes:
# ZohoCRM.modules.ALL,ZohoCRM.settings.ALL,ZohoCRM.send_mail.all.CREATE,ZohoMail.accounts.READ,ZohoMail.messages.CREATE
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Zoho Data Center Accounts and API URLs
# Default for Indian business registration: accounts.zoho.in / www.zohoapis.in
# For US / Global DC accounts: accounts.zoho.com / www.zohoapis.com
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in

# 7. Google Gemini API for Bazzar AI Corporate Assistant
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
GEMINI_MODEL=gemini-3.6-flash

# 8. OfficeBazzar Private Blog Admin Panel (https://www.officebazzar.com/blog-admin-panel)
# Single authorized administrator username
BLOG_ADMIN_USERNAME=officebazzar_admin
# Secure scrypt password hash of your chosen admin password (generate via /blog-admin-panel helper or Node crypto)
BLOG_ADMIN_PASSWORD_HASH=
# Random 32+ character key to sign and verify secure session cookies
BLOG_ADMIN_SESSION_SECRET=
# GitHub Personal Access Token or fine-grained token with Contents: Read & Write for automated Vercel git commits in production
GITHUB_TOKEN=
