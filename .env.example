# ==============================================================================
# OfficeBazzar E-Commerce Production Environment Configuration Template
# Copy this file to .env.local and populate with your credentials.
# Never commit .env.local containing live secrets to public version control.
# ==============================================================================

# 1. Site Public URL (Used for SEO Canonical, OpenGraph & Sitemap Generation)
NEXT_PUBLIC_SITE_URL=https://officebazzar.com

# 2. Supabase PostgreSQL & Auth Credentials
# Obtain from: https://supabase.com/dashboard/project/<project-ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=eyJh...your-secret-service-role-key

# 3. Razorpay Payment Gateway Credentials (Optional fallback / legacy orders)
# Obtain from: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_key

# 4. Registered Corporate Tax Data
# Set only after verifying against official corporate GST registration certificate
OFFICEBAZZAR_GSTIN=

# 5. Security & Session Secrets
ADMIN_SECRET_KEY=generate-a-cryptographically-secure-random-token

# 6. B2B Quotation System & Notification Engine Configuration
# Recipient destinations for Request a Quote submissions (sent to both Sales and Marketing)
QUOTE_SALES_EMAIL=sales4@officebazzar.com
QUOTE_MARKETING_EMAIL=marketing@officebazzar.com
ADMIN_NOTIFICATION_EMAIL=admin@officebazzar.co.in
SALES_MANAGER_NOTIFICATION_EMAIL=sales@officebazzar.co.in

# Transactional Email Service (Resend / SendGrid / Postmark / SMTP)
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@officebazzar.co.in

# Optional Official Meta WhatsApp Business Platform
# Configured via Meta for Developers: https://developers.facebook.com/apps/
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_PHONE=+919043849095
WHATSAPP_SALES_PHONE=
